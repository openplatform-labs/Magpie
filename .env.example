POSTGRES_DB=magpie
POSTGRES_USER=magpie
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://magpie:replace-with-a-long-random-password@db:5432/magpie
MAGPIE_ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
MAGPIE_ENCRYPTION_KEY=replace-with-a-fernet-key
# Optional, comma-separated exact HTTPS base URLs approved by an operator.
MAGPIE_ALLOWED_PROVIDER_BASES=
# Provider request and streaming idle timeout, in seconds (1–3600).
MAGPIE_PROVIDER_TIMEOUT_SECONDS=60

# Optional TLS Compose override. Use absolute paths to operator-managed files.
# MAGPIE_TLS_CERT=/secure/path/fullchain.pem
# MAGPIE_TLS_KEY=/secure/path/private-key.pem
# MAGPIE_TLS_BIND=127.0.0.1
# MAGPIE_TLS_PORT=8443

# Optional external management backend; public key only, disabled unless all set.
# MAGPIE_PROXY_PUBLIC_KEY_FILE=/run/config/management-public.pem
# MAGPIE_PROXY_ISSUER=https://management.example.invalid
# MAGPIE_PROXY_AUDIENCE=magpie:installation-uuid
